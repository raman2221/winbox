<Project Sdk="Microsoft.NET.Sdk">

  <!-- Targets .NET Framework 4.8 because Windows Sandbox ships it, so the helper runs with nothing to install. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Winbox.Protocol\Winbox.Protocol.csproj" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <InternalsVisibleTo Include="Winbox.Guest.Tests" />
  </ItemGroup>

</Project>
